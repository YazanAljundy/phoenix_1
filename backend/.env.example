MONGODB_URI=mongodb://localhost:27017/phoenix
# Must be at least 32 characters. Generate one with:  openssl rand -base64 32
# A short or guessable secret lets anyone forge tokens for any account, so
# the server refuses to start below that length.
JWT_SECRET=
# Access-token lifetime. 24h, deliberately short (audit F-03) - clients ride
# over the expiry with a refresh token instead of forcing a re-login.
# NOTE: this variable overrides the code default, so a deployment that still
# sets 7d here keeps 7d.
JWT_EXPIRES_IN=24h
# How long an idle session survives before requiring a full login. Refresh
# tokens rotate on every use, so this caps idleness, not session length.
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
NODE_ENV=development

# SMS OTP provider (Section 3 of the spec) - not yet chosen.
# Set SMS_PROVIDER to "console" during development: OTPs are logged instead of sent.
# Once a provider is tested against a real Syrian number, set SMS_PROVIDER to its name
# (e.g. "unimatrix") and fill in the matching keys below.
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Firebase Cloud Messaging (push notifications) - two ways to supply the
# service account credential, checked in this order by config/firebase.js:
#   1. FIREBASE_SERVICE_ACCOUNT_PATH - an absolute path to the downloaded
#      serviceAccount.json (local dev; keep it OUTSIDE this repo, never
#      committed).
#   2. The three fields below, set directly as env vars (for hosts like
#      Railway/Heroku with no persistent filesystem to point a path at).
# If neither is present, notifications are silently disabled - nothing else
# in the app depends on them.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Cloudinary - stores every user-uploaded image (banner images, return
# photos). Values come from the Cloudinary dashboard (Settings -> API Keys).
# Required for banner/return image uploads to work; without them those
# endpoints return an error and nothing else in the app is affected.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

IMAGE_API_KEY=

# Open Exchange Rates (openexchangerates.org) - free-tier key, used only to
# read GET /latest.json?symbols=SYP once a day (Section 15: keep out of
# version control, same as every other key in this file - .env is
# gitignored, only .env.example is tracked).
EXCHANGE_RATE_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
