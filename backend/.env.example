MONGODB_URI=mongodb://localhost:27017/phoenix
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development

# SMS OTP provider (Section 3 of the spec) - not yet chosen.
# Set SMS_PROVIDER to "console" during development: OTPs are logged instead of sent.
# Once a provider is tested against a real Syrian number, set SMS_PROVIDER to its name
# (e.g. "unimatrix") and fill in the matching keys below.
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

IMAGE_API_KEY=

# Open Exchange Rates (openexchangerates.org) - free-tier key, used only to
# read GET /latest.json?symbols=SYP once a day (Section 15: keep out of
# version control, same as every other key in this file - .env is
# gitignored, only .env.example is tracked).
EXCHANGE_RATE_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
